<UserControl x:Class="DoAn.Views.HopDongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <UserControl.Resources>
        <DropShadowEffect x:Key="SoftCardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.05"/>

        <Style x:Key="RoundedBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6.7*"/>
            <ColumnDefinition Width="3.3*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= CỘT TRÁI: DANH SÁCH HỢP ĐỒNG ================= -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,16,0"
                BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="📋 Danh sách Hợp đồng thuê phòng" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⏳ Gia hạn +6 tháng" Command="{Binding GiaHan6ThangCommand}"
                                Style="{StaticResource RoundedBtnStyle}" Background="#F59E0B" Margin="0,0,8,0"/>
                        <Button Content="🔄 Trả phòng &amp; Hoàn cọc" Command="{Binding TraPhongThanhLyCommand}"
                                Style="{StaticResource RoundedBtnStyle}" Background="#EF4444"/>
                    </StackPanel>
                </DockPanel>

                <!-- Bảng danh sách hợp đồng -->
                <DataGrid ItemsSource="{Binding DanhSachHopDong}" SelectedItem="{Binding HopDongDangChon}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã HĐ" Binding="{Binding MaHopDong}" Width="Auto" MinWidth="112" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Phòng" Binding="{Binding Phong.MaPhong}" Width="Auto" MinWidth="62" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Khách đại diện" Binding="{Binding KhachDaiDien.HoTen}" Width="*" MinWidth="135"/>
                        <DataGridTextColumn Header="Từ ngày" Binding="{Binding NgayBatDau, StringFormat='{}{0:dd/MM/yyyy}'}" Width="Auto" MinWidth="96"/>
                        <DataGridTextColumn Header="Đến ngày" Binding="{Binding NgayKetThuc, StringFormat='{}{0:dd/MM/yyyy}'}" Width="Auto" MinWidth="96"/>
                        <DataGridTextColumn Header="Giá thuê" Binding="{Binding GiaThueChot, StringFormat='{}{0:N0} đ'}" Width="Auto" MinWidth="105" FontWeight="SemiBold"/>

                        <!-- Cột trạng thái dạng Badge có chấm tròn Ellipse -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="Auto" MinWidth="108">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusBadge" Background="#D1FAE5" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StatusText" Text="Hiệu lực" Foreground="#047857" FontSize="11.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TrangThai}" Value="1">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#F1F5F9"/>
                                            <Setter TargetName="StatusDot" Property="Fill" Value="#64748B"/>
                                            <Setter TargetName="StatusText" Property="Text" Value="Đã đóng"/>
                                            <Setter TargetName="StatusText" Property="Foreground" Value="#475569"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ================= CỘT PHẢI: LẬP HỢP ĐỒNG MỚI ================= -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"
                BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="📄 Lập Hợp đồng mới" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Chọn phòng trống và khách đại diện để ký hợp đồng" FontSize="12" Foreground="#64748B" Margin="0,3,0,12"/>
                    <Separator Background="#E2E8F0" Margin="0,0,0,14"/>

                    <TextBlock Text="Mã hợp đồng" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding MaHopDong, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,10"/>

                    <TextBlock Text="Chọn Phòng đang trống *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding DanhSachPhongTrong}" SelectedItem="{Binding PhongChon}"
                              DisplayMemberPath="TenPhong" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Chọn Khách thuê đại diện *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding DanhSachKhachThue}" SelectedItem="{Binding KhachChon}"
                              DisplayMemberPath="HoTen" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Ngày bắt đầu" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding NgayBatDau}" Height="34" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Ngày kết thúc" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding NgayKetThuc}" Height="34" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Giá thuê chốt (VNĐ)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding GiaThueChot, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Tiền đặt cọc (VNĐ)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding TienCoc, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,18">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Số người ở" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SoNguoiO, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Số lượng xe máy" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SoLuongXe, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <Button Content="✅ KÝ HỢP ĐỒNG &amp; NHẬN PHÒNG" Command="{Binding LapHopDongCommand}"
                            Style="{StaticResource RoundedBtnStyle}" Background="#2563EB" FontWeight="Bold" Height="42" Margin="0,0,0,10"/>
                    <Button Content="🔄 Làm mới biểu mẫu" Command="{Binding LamMoiCommand}"
                            Style="{StaticResource RoundedBtnStyle}" Background="#64748B" Height="36"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>