<UserControl x:Class="DoAn.Views.HopDongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6.5*"/>
            <ColumnDefinition Width="3.5*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: DANH SÁCH HỢP ĐỒNG -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="📋 Danh sách Hợp đồng thuê phòng" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⏳ Gia hạn +6 tháng" Command="{Binding GiaHan6ThangCommand}" Background="#F59E0B" Foreground="White" FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,0" BorderThickness="0"/>
                        <Button Content="🔄 Trả phòng &amp; Hoàn cọc" Command="{Binding TraPhongThanhLyCommand}" Background="#EF4444" Foreground="White" FontWeight="SemiBold" Padding="12,6" BorderThickness="0"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid ItemsSource="{Binding DanhSachHopDong}" SelectedItem="{Binding HopDongDangChon}"
                          AutoGenerateColumns="False" IsReadOnly="True" RowHeight="36" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#CBD5E1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã HĐ" Binding="{Binding MaHopDong}" Width="105" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Phòng" Binding="{Binding Phong.MaPhong}" Width="65"/>
                        <DataGridTextColumn Header="Khách đại diện" Binding="{Binding KhachDaiDien.HoTen}" Width="140"/>
                        <DataGridTextColumn Header="Từ ngày" Binding="{Binding NgayBatDau, StringFormat='{}{0:dd/MM/yyyy}'}" Width="90"/>
                        <DataGridTextColumn Header="Đến ngày" Binding="{Binding NgayKetThuc, StringFormat='{}{0:dd/MM/yyyy}'}" Width="90"/>
                        <DataGridTextColumn Header="Giá thuê" Binding="{Binding GiaThueChot, StringFormat='{}{0:N0}'}" Width="95"/>
                        <DataGridTextColumn Header="TT (0:Hiệu lực, 1:Đóng)" Binding="{Binding TrangThai}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- CỘT PHẢI: LẬP HỢP ĐỒNG MỚI -->
        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="📄 Lập Hợp đồng mới" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                <TextBlock Text="Mã hợp đồng" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding MaHopDong}" Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8"/>

                <TextBlock Text="Chọn Phòng đang trống (*)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding DanhSachPhongTrong}" SelectedItem="{Binding PhongChon}"
                          DisplayMemberPath="TenPhong" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock Text="Chọn Khách thuê đại diện (*)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding DanhSachKhachThue}" SelectedItem="{Binding KhachChon}"
                          DisplayMemberPath="HoTen" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Ngày bắt đầu" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding NgayBatDau}" Height="30"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="Ngày kết thúc" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding NgayKetThuc}" Height="30"/>
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Giá thuê chốt" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding GiaThueChot}" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="Tiền đặt cọc" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding TienCoc}" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,0,0,16">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Số người ở" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SoNguoiO}" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="Số lượng xe máy" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SoLuongXe}" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                </UniformGrid>

                <Button Content="✅ KÝ HỢP ĐỒNG &amp; NHẬN PHÒNG" Command="{Binding LapHopDongCommand}"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" Height="40" Margin="0,0,0,8" BorderThickness="0"/>
                <Button Content="🔄 Làm mới biểu mẫu" Command="{Binding LamMoiCommand}"
                        Background="#64748B" Foreground="White" FontWeight="SemiBold" Height="34" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>