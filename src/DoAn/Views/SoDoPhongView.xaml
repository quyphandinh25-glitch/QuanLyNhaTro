<UserControl x:Class="DoAn.Views.SoDoPhongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. THANH CÔNG CỤ LỌC & CHÚ THÍCH TRẠNG THÁI -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="18,12" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <!-- Bộ lọc bên trái -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏢 Tầng:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding DanhSachTangLoc}" SelectedItem="{Binding TangLocChon}" Width="120" Height="34" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                    <TextBlock Text="🎨 Trạng thái:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding DanhSachTrangThaiLoc}" SelectedItem="{Binding TrangThaiLocChon}" Width="155" Height="34" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                    <TextBlock Text="🔍 Tìm:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="34" VerticalContentAlignment="Center" Padding="10,0"/>
                </StackPanel>

                <!-- Huy hiệu đếm số lượng dùng chấm tròn Ellipse sắc nét -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="16" Padding="12,5" Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DemTrong, StringFormat='Trống: {0}'}" Foreground="#047857" FontWeight="Bold" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="16" Padding="12,5" Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DemDangThue, StringFormat='Đang thuê: {0}'}" Foreground="#1D4ED8" FontWeight="Bold" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="16" Padding="12,5" Margin="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DemSapHet, StringFormat='Sắp hết: {0}'}" Foreground="#B45309" FontWeight="Bold" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FEF2F2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="16" Padding="12,5" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DemBaoTri, StringFormat='Bảo trì: {0}'}" Foreground="#B91C1C" FontWeight="Bold" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. VÙNG CHÍNH: LƯỚI SƠ ĐỒ PHÒNG (TRÁI) & PANEL THAO TÁC NHANH (PHẢI) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.8*"/>
                <ColumnDefinition Width="3.2*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: LƯỚI Ô PHÒNG -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="14" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <ListBox ItemsSource="{Binding DanhSachPhongSoDo}" SelectedItem="{Binding PhongDangChon}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Margin" Value="8"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CardWrapper" CornerRadius="12" Background="Transparent" BorderThickness="2.5" BorderBrush="Transparent">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#0F172A" BlurRadius="8" ShadowDepth="2" Opacity="0.06"/>
                                            </Border.Effect>
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardWrapper" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#1E40AF" BlurRadius="16" ShadowDepth="4" Opacity="0.18"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CardWrapper" Property="BorderBrush" Value="#2563EB"/>
                                                <Setter TargetName="CardWrapper" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#2563EB" BlurRadius="20" ShadowDepth="0" Opacity="0.35"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>

                            <Style.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RoomCard" Width="200" Height="142" CornerRadius="10" Padding="14"
                                    Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1.8">
                                <StackPanel>
                                    <!-- Dòng 1: Mã phòng + Tầng -->
                                    <DockPanel>
                                        <TextBlock x:Name="TxtMaPhong" Text="{Binding MaPhong}" FontSize="18" FontWeight="Bold" Foreground="#065F46"/>
                                        <Border Background="#FFFFFF" Opacity="0.85" CornerRadius="6" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tang, StringFormat='Tầng {0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>
                                        </Border>
                                    </DockPanel>

                                    <!-- Dòng 2: Huy hiệu Trạng thái có chấm tròn Ellipse chuẩn màu -->
                                    <Border Background="{Binding MauNenBadge}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" Margin="0,6,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding MauChamTron}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TenTrangThai}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding MauChuTrangThai}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Dòng 3: Giá thuê -->
                                    <TextBlock Text="{Binding GiaThue, StringFormat='💰 {0:N0} đ/tháng'}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>

                                    <!-- Dòng 4: Khách đang ở -->
                                    <TextBlock Text="{Binding TenKhachHienTai, StringFormat='👤 {0}'}" FontSize="12" Foreground="#334155" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <DataTemplate.Triggers>
                                <!-- 1: Đang thuê (Xanh dương) -->
                                <DataTrigger Binding="{Binding TrangThai}" Value="1">
                                    <Setter TargetName="RoomCard" Property="Background" Value="#EFF6FF"/>
                                    <Setter TargetName="RoomCard" Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter TargetName="TxtMaPhong" Property="Foreground" Value="#1E40AF"/>
                                </DataTrigger>
                                <!-- 2: Sắp hết hạn (Vàng cam) -->
                                <DataTrigger Binding="{Binding TrangThai}" Value="2">
                                    <Setter TargetName="RoomCard" Property="Background" Value="#FFFBEB"/>
                                    <Setter TargetName="RoomCard" Property="BorderBrush" Value="#F59E0B"/>
                                    <Setter TargetName="TxtMaPhong" Property="Foreground" Value="#92400E"/>
                                </DataTrigger>
                                <!-- 3: Đang bảo trì (Đỏ) -->
                                <DataTrigger Binding="{Binding TrangThai}" Value="3">
                                    <Setter TargetName="RoomCard" Property="Background" Value="#FEF2F2"/>
                                    <Setter TargetName="RoomCard" Property="BorderBrush" Value="#EF4444"/>
                                    <Setter TargetName="TxtMaPhong" Property="Foreground" Value="#991B1B"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- CỘT PHẢI: PANEL CHI TIẾT PHÒNG & THAO TÁC NHANH -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="📌 Chi tiết Phòng chọn" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                        <Separator Background="#E2E8F0" Margin="0,10,0,14"/>

                        <!-- Tên phòng + Huy hiệu trạng thái đồng bộ màu 100% -->
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding PhongDangChon.TenPhong, StringFormat='🚪 {0}'}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                            <Border Background="{Binding PhongDangChon.MauNenBadge}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{Binding PhongDangChon.MauChamTron}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PhongDangChon.TenTrangThai}" FontSize="12.5" FontWeight="Bold" Foreground="{Binding PhongDangChon.MauChuTrangThai}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>

                        <!-- Khung thông tin chi tiết -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding PhongDangChon.TenLoaiPhong, StringFormat='• Loại phòng: {0}'}" FontSize="13" Foreground="#334155" Margin="0,0,0,7"/>
                                <TextBlock Text="{Binding PhongDangChon.GiaThue, StringFormat='• Giá niêm yết: {0:N0} VNĐ/tháng'}" FontSize="13" Foreground="#334155" Margin="0,0,0,7"/>
                                <TextBlock Text="{Binding PhongDangChon.TenKhachHienTai, StringFormat='• Khách đại diện: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,7"/>
                                <TextBlock Text="{Binding PhongDangChon.SoDienThoaiKhach, StringFormat='• SĐT khách: {0}'}" FontSize="13" Foreground="#334155" Margin="0,0,0,7"/>
                                <TextBlock Text="{Binding PhongDangChon.HanHopDongText, StringFormat='• Thời hạn HĐ: {0}'}" FontSize="13" Foreground="#334155" Margin="0,0,0,7"/>
                                <TextBlock Text="{Binding PhongDangChon.TienCocHienTai, StringFormat='• Tiền cọc đang giữ: {0:N0} VNĐ'}" FontSize="13" Foreground="#334155" Margin="0,0,0,7"/>
                                <TextBlock Text="{Binding PhongDangChon.GhiChuSuCo, StringFormat='• Ghi chú/Sự cố: {0}'}" FontSize="13" FontWeight="Medium" Foreground="#DC2626" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Separator Background="#E2E8F0" Margin="0,0,0,12"/>
                        <TextBlock Text="⚡ THAO TÁC NHANH" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                        <!-- 1. Cho thuê nhanh (Dành cho Phòng Trống) -->
                        <TextBlock Text="Chọn khách để cho thuê nhanh (Phòng trống):" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding DanhSachKhachThue}" SelectedItem="{Binding KhachThueNhanhChon}"
                                  DisplayMemberPath="HoTen" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                        <Button Content="➕ Cho thuê nhanh (Ký HĐ 1 năm)" Command="{Binding ChoThueNhanhCommand}" Cursor="Hand"
                                Background="#10B981" Foreground="White" FontWeight="Bold" Height="38" Margin="0,0,0,12" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- 2. Gia hạn & Trả phòng nhanh -->
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Button Content="⏳ Gia hạn +6th" Command="{Binding GiaHanNhanhCommand}" Cursor="Hand"
                                    Background="#2563EB" Foreground="White" FontWeight="Bold" Height="38" Margin="0,0,5,0" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="🔄 Trả phòng" Command="{Binding TraPhongNhanhCommand}" Cursor="Hand"
                                    Background="#F59E0B" Foreground="White" FontWeight="Bold" Height="38" Margin="5,0,0,0" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </UniformGrid>

                        <!-- 3. Báo sự cố bảo trì / Mở lại phòng -->
                        <TextBlock Text="Nội dung sự cố / bảo trì (nếu có):" FontSize="12" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NoiDungBaoSuCo}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8"/>
                        <Button Content="🛠️ Báo Bảo trì / Hoàn tất Bảo trì" Command="{Binding ChuyenTrangThaiBaoTriCommand}" Cursor="Hand"
                                Background="#EF4444" Foreground="White" FontWeight="Bold" Height="38" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>