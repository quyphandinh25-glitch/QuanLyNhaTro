<UserControl x:Class="DoAn.Views.SuCoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <UserControl.Resources>
        <DropShadowEffect x:Key="SoftCardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.05"/>

        <Style x:Key="RoundedBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6.5*"/>
            <ColumnDefinition Width="3.5*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= CỘT TRÁI: DANH SÁCH SỰ CỐ & THỐNG KÊ CHI PHÍ ================= -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,16,0"
                BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
            <DockPanel>
                <!-- Thanh lọc trạng thái & nút Hoàn tất nhanh -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Trạng thái:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding DanhSachLocTrangThai}" SelectedItem="{Binding LocTrangThaiChon}"
                                  Width="190" Height="34" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right" Content="✅ Đã sửa xong &amp; Mở phòng"
                            Command="{Binding HoanTatSuaChuaCommand}" IsEnabled="{Binding CoTheHoanTat}"
                            Style="{StaticResource RoundedBtnStyle}" Background="#10B981" Height="36"/>
                </DockPanel>

                <!-- Thanh tìm kiếm nhanh & số lượng -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍 Tìm phòng / sự cố:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220" Height="32" VerticalContentAlignment="Center" Padding="10,0"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SoLuongHienThiText}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                    </Border>
                </DockPanel>

                <!-- 3 Thẻ tóm tắt tình hình bảo trì -->
                <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,14">
                    <Border Background="#FEF2F2" CornerRadius="10" Padding="14,10" Margin="0,0,6,0" BorderBrush="#FECACA" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SỰ CỐ ĐANG XỬ LÝ" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"/>
                            <TextBlock Text="{Binding SoSuCoDangXuLy, StringFormat='{}{0} sự cố'}" FontSize="17" FontWeight="Bold" Foreground="#991B1B" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#ECFDF5" CornerRadius="10" Padding="14,10" Margin="3,0,3,0" BorderBrush="#A7F3D0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ĐÃ HOÀN THÀNH" FontSize="11" FontWeight="Bold" Foreground="#047857"/>
                            <TextBlock Text="{Binding SoSuCoDaHoanThanh, StringFormat='{}{0} sự cố'}" FontSize="17" FontWeight="Bold" Foreground="#065F46" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFBEB" CornerRadius="10" Padding="14,10" Margin="6,0,0,0" BorderBrush="#FDE68A" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TỔNG CHI PHÍ SỬA" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                            <TextBlock Text="{Binding TongChiPhiSuaChua, StringFormat='{}{0:N0} đ'}" FontSize="17" FontWeight="Bold" Foreground="#92400E" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Bảng danh sách sự cố (chống cắt chữ + Badge màu trạng thái) -->
                <DataGrid ItemsSource="{Binding DanhSachSuCo}" SelectedItem="{Binding SuCoDangChon}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Phòng" Binding="{Binding Phong.MaPhong}" Width="Auto" MinWidth="64" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Tiêu đề sự cố" Binding="{Binding TieuDe}" Width="*" MinWidth="165" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Ngày báo" Binding="{Binding NgayBao, StringFormat='{}{0:dd/MM/yyyy}'}" Width="Auto" MinWidth="95"/>
                        <DataGridTextColumn Header="Chi phí" Binding="{Binding ChiPhiSuaChua, StringFormat='{}{0:N0} đ'}" Width="Auto" MinWidth="98" Foreground="#DC2626" FontWeight="Bold"/>

                        <!-- Cột trạng thái dạng Badge có chấm tròn Ellipse -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="Auto" MinWidth="128">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="IssueBadge" Background="#FEF3C7" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="IssueDot" Width="7" Height="7" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="IssueText" Text="Mới tiếp nhận" Foreground="#B45309" FontSize="11.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TrangThai}" Value="1">
                                            <Setter TargetName="IssueBadge" Property="Background" Value="#FEE2E2"/>
                                            <Setter TargetName="IssueDot" Property="Fill" Value="#EF4444"/>
                                            <Setter TargetName="IssueText" Property="Text" Value="Đang sửa chữa"/>
                                            <Setter TargetName="IssueText" Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TrangThai}" Value="2">
                                            <Setter TargetName="IssueBadge" Property="Background" Value="#D1FAE5"/>
                                            <Setter TargetName="IssueDot" Property="Fill" Value="#10B981"/>
                                            <Setter TargetName="IssueText" Property="Text" Value="Hoàn thành"/>
                                            <Setter TargetName="IssueText" Property="Foreground" Value="#047857"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ================= CỘT PHẢI: BIỂU MẪU GHI NHẬN & CẬP NHẬT SỰ CỐ ================= -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"
                BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="🛠️ Ghi nhận Sự cố &amp; Bảo trì" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Chọn sự cố bên trái để sửa hoặc nhập mới khi phát sinh hư hỏng" FontSize="12" Foreground="#64748B" Margin="0,3,0,12"/>
                    <Separator Background="#E2E8F0" Margin="0,0,0,14"/>

                    <TextBlock Text="Chọn Phòng gặp sự cố *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding DanhSachPhong}" SelectedItem="{Binding PhongChon}"
                              DisplayMemberPath="TenPhong" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Tiêu đề hư hỏng *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding TieuDe, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,12"/>

                    <TextBlock Text="Mô tả chi tiết tình trạng" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding MoTaChiTiet, UpdateSourceTrigger=PropertyChanged}" Height="68" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,6" Margin="0,0,0,12"/>

                    <UniformGrid Columns="2" Margin="0,0,0,14">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Chi phí sửa chữa (VNĐ)" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ChiPhiSuaChua, UpdateSourceTrigger=PropertyChanged}" Height="34"
                                     VerticalContentAlignment="Center" Padding="10,0" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Trạng thái xử lý" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding DanhSachTrangThaiForm}"
                                      DisplayMemberPath="Ten"
                                      SelectedValuePath="Ma"
                                      SelectedValue="{Binding TrangThai}"
                                      Height="34" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>

                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,18">
                        <CheckBox IsChecked="{Binding ChuyenPhongSangBaoTri}"
                                  Content="Chuyển phòng sang trạng thái Đang bảo trì"
                                  FontSize="12.5" FontWeight="SemiBold" Foreground="#B91C1C" VerticalContentAlignment="Center"/>
                    </Border>

                    <UniformGrid Columns="2">
                        <Button Content="➕ Báo sự cố" Command="{Binding ThemSuCoCommand}" Style="{StaticResource RoundedBtnStyle}" Background="#2563EB" Margin="0,0,5,10"/>
                        <Button Content="✏️ Cập nhật" Command="{Binding CapNhatSuCoCommand}" Style="{StaticResource RoundedBtnStyle}" Background="#F59E0B" Margin="5,0,0,10"/>
                        <Button Content="🗑️ Xóa" Command="{Binding XoaSuCoCommand}" Style="{StaticResource RoundedBtnStyle}" Background="#EF4444" Margin="0,0,5,0"/>
                        <Button Content="🔄 Làm mới" Command="{Binding LamMoiCommand}" Style="{StaticResource RoundedBtnStyle}" Background="#64748B" Margin="5,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>