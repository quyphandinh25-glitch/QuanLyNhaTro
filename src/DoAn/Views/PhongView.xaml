<UserControl x:Class="DoAn.Views.PhongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <UserControl.Resources>
        <DropShadowEffect x:Key="SoftCardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.05"/>

        <Style x:Key="RoundedBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6.6*"/>
            <ColumnDefinition Width="3.4*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= CỘT TRÁI: DANH SÁCH PHÒNG ================= -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,16,0"
                BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
            <DockPanel>
                <!-- Thanh tìm kiếm & lọc trạng thái -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍 Tìm:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
                                 Width="210" Height="34" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,14,0"/>

                        <TextBlock Text="Trạng thái:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding DanhSachTrangThaiLoc}" SelectedItem="{Binding TrangThaiLocChon}"
                                  Width="150" Height="34" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TongHienThiText}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                    </Border>
                </DockPanel>

                <!-- Bảng danh sách phòng (kế thừa Style DataGrid chuẩn SaaS từ App.xaml) -->
                <DataGrid ItemsSource="{Binding DanhSachPhong}" SelectedItem="{Binding PhongDangChon}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding MaPhong}" Width="70" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Tên phòng" Binding="{Binding TenPhong}" Width="110"/>
                        <DataGridTextColumn Header="Tầng" Binding="{Binding Tang, StringFormat='Tầng {0}'}" Width="70"/>
                        <DataGridTextColumn Header="Loại phòng" Binding="{Binding TenLoaiPhong}" Width="*"/>
                        <DataGridTextColumn Header="Giá thuê" Binding="{Binding GiaThueHienTai, StringFormat='{}{0:N0} đ'}" Width="115" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Khách đang ở" Binding="{Binding TenKhachHienTai}" Width="135"/>
                        <DataGridTemplateColumn Header="Trạng thái" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding MauNenBadge}" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding MauChamTron}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TenTrangThai}" Foreground="{Binding MauChuBadge}" FontSize="11.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ================= CỘT PHẢI: BIỂU MẪU NHẬP LIỆU ================= -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"
                BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="🚪 Chi tiết &amp; Cập nhật Phòng" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Chọn một phòng bên trái để sửa hoặc nhập mới để thêm phòng" FontSize="12" Foreground="#64748B" Margin="0,3,0,12"/>
                    <Separator Background="#E2E8F0" Margin="0,0,0,14"/>

                    <!-- Hàng 1: Mã phòng & Tầng -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6.5*"/>
                            <ColumnDefinition Width="3.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Mã phòng *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding MaPhong, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Tầng *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Tang, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tên phòng -->
                    <TextBlock Text="Tên phòng *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding TenPhong, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,12"/>

                    <!-- Loại phòng -->
                    <TextBlock Text="Loại phòng *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding DanhSachLoaiPhong}" SelectedItem="{Binding LoaiPhongChon}"
                              DisplayMemberPath="TenLoai" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Giá thuê -->
                    <TextBlock Text="Giá thuê niêm yết (VNĐ/tháng) *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding GiaThueHienTai, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,12"/>

                    <!-- Trạng thái dùng ComboBox trực quan -->
                    <TextBlock Text="Trạng thái phòng" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding DanhSachTrangThaiForm}"
                              DisplayMemberPath="Ten"
                              SelectedValuePath="Ma"
                              SelectedValue="{Binding TrangThai}"
                              Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <!-- Ghi chú -->
                    <TextBlock Text="Ghi chú nội thất / tình trạng" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}" Height="56" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,6" Margin="0,0,0,18"/>

                    <!-- Cụm nút thao tác -->
                    <UniformGrid Columns="2">
                        <Button Content="➕ Thêm mới" Command="{Binding ThemMoiCommand}" Style="{StaticResource RoundedBtnStyle}" Background="#2563EB" Margin="0,0,5,10"/>
                        <Button Content="✏️ Cập nhật" Command="{Binding CapNhatCommand}" Style="{StaticResource RoundedBtnStyle}" Background="#10B981" Margin="5,0,0,10"/>
                        <Button Content="🗑️ Xóa phòng" Command="{Binding XoaCommand}" Style="{StaticResource RoundedBtnStyle}" Background="#EF4444" Margin="0,0,5,0"/>
                        <Button Content="🔄 Làm mới" Command="{Binding LamMoiCommand}" Style="{StaticResource RoundedBtnStyle}" Background="#64748B" Margin="5,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>