<UserControl x:Class="DoAn.Views.PhongView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6.5*"/>
            <ColumnDefinition Width="3.5*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: DANH SÁCH PHÒNG -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="🔍 Tìm phòng:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding DanhSachPhong}" SelectedItem="{Binding PhongDangChon}"
                          AutoGenerateColumns="False" IsReadOnly="True" RowHeight="36" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#CBD5E1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã" Binding="{Binding MaPhong}" Width="70" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Tên phòng" Binding="{Binding TenPhong}" Width="110"/>
                        <DataGridTextColumn Header="Tầng" Binding="{Binding Tang}" Width="55"/>
                        <DataGridTextColumn Header="Loại phòng" Binding="{Binding LoaiPhong.TenLoai}" Width="*"/>
                        <DataGridTextColumn Header="Giá thuê (VNĐ)" Binding="{Binding GiaThueHienTai, StringFormat='{}{0:N0}'}" Width="110"/>
                        <DataGridTextColumn Header="TT (0:Trống, 1:Thuê)" Binding="{Binding TrangThai}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- CỘT PHẢI: BIỂU MẪU NHẬP LIỆU -->
        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🚪 Thông tin Phòng" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                <TextBlock Text="Mã phòng (VD: P105)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding MaPhong}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                <TextBlock Text="Tên phòng" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding TenPhong}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                <TextBlock Text="Tầng" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Tang}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                <TextBlock Text="Loại phòng" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding DanhSachLoaiPhong}" SelectedItem="{Binding LoaiPhongChon}"
                          DisplayMemberPath="TenLoai" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="Giá thuê hiện tại (VNĐ)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding GiaThueHienTai}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                <TextBlock Text="Trạng thái (0:Trống, 1:Đang thuê, 2:Sắp hết, 3:Bảo trì)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding TrangThai}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                <TextBlock Text="Ghi chú" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding GhiChu}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,18"/>

                <UniformGrid Columns="2">
                    <Button Content="➕ Thêm mới" Command="{Binding ThemMoiCommand}" Background="#2563EB" Foreground="White" FontWeight="Bold" Height="36" Margin="0,0,4,8" BorderThickness="0"/>
                    <Button Content="✏️ Cập nhật" Command="{Binding CapNhatCommand}" Background="#10B981" Foreground="White" FontWeight="Bold" Height="36" Margin="4,0,0,8" BorderThickness="0"/>
                    <Button Content="🗑️ Xóa phòng" Command="{Binding XoaCommand}" Background="#EF4444" Foreground="White" FontWeight="Bold" Height="36" Margin="0,0,4,0" BorderThickness="0"/>
                    <Button Content="🔄 Làm mới" Command="{Binding LamMoiCommand}" Background="#64748B" Foreground="White" FontWeight="Bold" Height="36" Margin="4,0,0,0" BorderThickness="0"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>