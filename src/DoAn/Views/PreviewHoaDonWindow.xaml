<Window x:Class="DoAn.Views.PreviewHoaDonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem trước Hóa đơn" Height="750" Width="850"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Thanh công cụ có nút In luôn sáng rõ -->
        <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <TextBlock Text="📄 Xem trước phiếu báo tiền trọ" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                <Button Content="🖨️ IN / LƯU FILE PDF" Click="BtnPrint_Click"
                        HorizontalAlignment="Right" Background="#2563EB" Foreground="White" FontWeight="Bold"
                        Padding="18,8" BorderThickness="0" Cursor="Hand"/>
            </DockPanel>
        </Border>

        <!-- Vùng hiển thị trang hóa đơn -->
        <FlowDocumentReader x:Name="docReader" ViewingMode="Scroll"/>
    </DockPanel>
</Window>