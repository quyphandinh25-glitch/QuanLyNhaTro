<UserControl x:Class="DoAn.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <UserControl.Resources>
        <!-- Style ProgressBar bo tròn co giãn chuẩn SaaS -->
        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="6"/>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Nút hành động bo góc hiện đại -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="SoftCardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.05"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="6,4,6,18">
            <!-- ================= THANH TRẠNG THÁI & NÚT TIỆN ÍCH ================= -->
            <DockPanel Margin="0,0,0,16">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TrangThaiTaiDuLieu}" FontSize="12.5" FontWeight="Medium" Foreground="#475569"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔄 Làm mới" Command="{Binding TaiThongKeCommand}"
                            Style="{StaticResource ActionBtnStyle}" Background="#475569" Margin="0,0,8,0"/>
                    <Button Content="📥 Xuất Excel (.csv)" Command="{Binding XuatBaoCaoExcelCommand}"
                            Style="{StaticResource ActionBtnStyle}" Background="#10B981" Margin="0,0,8,0"/>
                    <Button Content="💾 Sao lưu CSDL" Command="{Binding SaoLuuDatabaseCommand}"
                            Style="{StaticResource ActionBtnStyle}" Background="#2563EB"/>
                </StackPanel>
            </DockPanel>

            <!-- ================= HÀNG 1: 4 THẺ KPI TỔNG QUAN PHÒNG ================= -->
            <UniformGrid Columns="4" Margin="0,0,0,18">
                <!-- KPI 1: Tổng số phòng -->
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,8,0"
                        BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="TỔNG SỐ PHÒNG" Foreground="#64748B" FontSize="11.5" FontWeight="Bold"/>
                            <TextBlock Text="{Binding TongSoPhong}" Foreground="#0F172A" FontSize="30" FontWeight="Bold" Margin="0,6,0,4"/>
                            <TextBlock Text="{Binding TyLeLapDayPhanTram, StringFormat='Công suất khai thác: {0}%'}" Foreground="#2563EB" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Border Width="42" Height="42" CornerRadius="10" Background="#F1F5F9" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="🏢" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 2: Đang cho thuê -->
                <Border Background="White" CornerRadius="12" Padding="18" Margin="4,0,4,0"
                        BorderBrush="#BFDBFE" BorderThickness="1.2" Effect="{StaticResource SoftCardShadow}">
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ĐANG CHO THUÊ" Foreground="#1D4ED8" FontSize="11.5" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SoPhongDangThue}" Foreground="#1E3A8A" FontSize="30" FontWeight="Bold" Margin="0,6,0,4"/>
                            <TextBlock Text="Hợp đồng đang hiệu lực" Foreground="#64748B" FontSize="12"/>
                        </StackPanel>
                        <Border Width="42" Height="42" CornerRadius="10" Background="#EFF6FF" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="🔑" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 3: Phòng trống -->
                <Border Background="White" CornerRadius="12" Padding="18" Margin="4,0,4,0"
                        BorderBrush="#A7F3D0" BorderThickness="1.2" Effect="{StaticResource SoftCardShadow}">
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PHÒNG TRỐNG" Foreground="#047857" FontSize="11.5" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SoPhongTrong}" Foreground="#065F46" FontSize="30" FontWeight="Bold" Margin="0,6,0,4"/>
                            <TextBlock Text="Sẵn sàng đón khách mới" Foreground="#64748B" FontSize="12"/>
                        </StackPanel>
                        <Border Width="42" Height="42" CornerRadius="10" Background="#ECFDF5" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="✨" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- KPI 4: Sắp hết hạn / Bảo trì -->
                <Border Background="White" CornerRadius="12" Padding="18" Margin="8,0,0,0"
                        BorderBrush="#FDE68A" BorderThickness="1.2" Effect="{StaticResource SoftCardShadow}">
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SẮP HẾT / " Foreground="#B45309" FontSize="11.5" FontWeight="Bold"/>
                                <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="2,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="BẢO TRÌ" Foreground="#B91C1C" FontSize="11.5" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                <TextBlock Text="{Binding SoPhongSapHetHan}" Foreground="#B45309" FontSize="30" FontWeight="Bold"/>
                                <TextBlock Text=" / " Foreground="#94A3B8" FontSize="24" Margin="4,3,4,0"/>
                                <TextBlock Text="{Binding SoPhongBaoTri}" Foreground="#DC2626" FontSize="30" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="Cần gia hạn hoặc xử lý sớm" Foreground="#64748B" FontSize="12"/>
                        </StackPanel>
                        <Border Width="42" Height="42" CornerRadius="10" Background="#FFFBEB" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="⚠️" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ================= HÀNG 2: TÀI CHÍNH & BIỂU ĐỒ HIỆU SUẤT ================= -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột trái: Tổng hợp Tài chính & Lợi nhuận -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,8,0"
                        BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <TextBlock Text="💰 Tổng hợp Tài chính &amp; Lợi nhuận" FontSize="15.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Tiền phòng dự kiến / tháng (theo HĐ hiệu lực)" Foreground="#475569" FontSize="13.5"/>
                            <TextBlock Text="{Binding DoanhThuDuKienThang, StringFormat='{}{0:N0} đ'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="#2563EB"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Tổng thực thu (Hóa đơn đã đóng)" Foreground="#475569" FontSize="13.5"/>
                            <TextBlock Text="{Binding TongDaThuThucTe, StringFormat='{}{0:N0} đ'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="#10B981"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Tổng công nợ gốc khách còn thiếu" Foreground="#475569" FontSize="13.5"/>
                            <TextBlock Text="{Binding TongCongNoChuaThu, StringFormat='{}{0:N0} đ'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="#EF4444"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Chi phí sửa chữa &amp; bảo trì" Foreground="#475569" FontSize="13.5"/>
                            <TextBlock Text="{Binding TongChiPhiBaoTri, StringFormat='-{0:N0} đ'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="#F59E0B"/>
                        </Grid>

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid>
                                <TextBlock Text="LỢI NHUẬN RÒNG THỰC TẾ" FontWeight="Bold" FontSize="13.5" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LoiNhuanRong, StringFormat='{}{0:N0} VNĐ'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="19" Foreground="#1D4ED8"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Cột phải: Biểu đồ ProgressBar co giãn linh hoạt -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="8,0,0,0"
                        BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <TextBlock Text="📈 Hiệu suất Khai thác &amp; Thu phí" FontSize="15.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18"/>

                        <!-- Thanh 1: Tỷ lệ lấp đầy -->
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="1. Tỷ lệ lấp đầy phòng trọ" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                            <TextBlock Text="{Binding TyLeLapDayPhanTram, StringFormat='{}{0}%'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="#2563EB"/>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding TyLeLapDayPhanTram}" Foreground="#2563EB" Margin="0,0,0,18"/>

                        <!-- Thanh 2: Tỷ lệ thực thu -->
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="2. Tỷ lệ hoàn thành thu tiền hóa đơn" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TongDaThuThucTe, StringFormat='{}{0:N0} đ'}" FontWeight="SemiBold" FontSize="12.5" Foreground="#64748B" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding TyLeDaThuPhanTram, StringFormat='({0}%)'}" FontWeight="Bold" FontSize="13" Foreground="#10B981"/>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding TyLeDaThuPhanTram}" Foreground="#10B981" Margin="0,0,0,18"/>

                        <!-- Thanh 3: Tỷ lệ công nợ -->
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="3. Tỷ lệ công nợ tồn đọng chưa thu" FontWeight="SemiBold" FontSize="13" Foreground="#334155"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TongCongNoChuaThu, StringFormat='{}{0:N0} đ'}" FontWeight="SemiBold" FontSize="12.5" Foreground="#64748B" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding TyLeCongNoPhanTram, StringFormat='({0}%)'}" FontWeight="Bold" FontSize="13" Foreground="#EF4444"/>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding TyLeCongNoPhanTram}" Foreground="#EF4444"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= HÀNG 3: 2 BẢNG CẢNH BÁO HÀNH ĐỘNG NHANH ================= -->
            <!-- ================= HÀNG 3: 2 BẢNG CẢNH BÁO HÀNH ĐỘNG NHANH ================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5.3*"/>
                    <ColumnDefinition Width="4.7*"/>
                </Grid.ColumnDefinitions>

                <!-- Bảng trái: Hợp đồng sắp hết hạn (30 ngày tới) -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,8,0"
                        BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="⏳ Hợp đồng sắp hết hạn (30 ngày tới)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Border Background="#FEF3C7" CornerRadius="12" Padding="10,3" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SoHopDongSapHet30Ngay, StringFormat='{}{0} hợp đồng'}" FontSize="12" FontWeight="Bold" Foreground="#B45309"/>
                            </Border>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding DanhSachHopDongSapHet}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Phòng" Binding="{Binding MaPhong}" Width="Auto" MinWidth="60" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Khách đại diện" Binding="{Binding TenKhach}" Width="*" MinWidth="115"/>
                                <DataGridTextColumn Header="SĐT" Binding="{Binding SoDienThoai}" Width="Auto" MinWidth="95"/>
                                <DataGridTextColumn Header="Hết hạn" Binding="{Binding NgayHetHanText}" Width="Auto" MinWidth="95"/>
                                <DataGridTemplateColumn Header="Cảnh báo" Width="Auto" MinWidth="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding MauNenBadge}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding CanhBaoText}" Foreground="{Binding MauChuBadge}" FontSize="11.5" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="✅ Hiện không có hợp đồng nào sắp hết hạn trong 30 ngày tới."
                                   Visibility="{Binding HienThiTrongHopDong}"
                                   Foreground="#10B981" FontSize="12.5" FontStyle="Italic" Margin="4,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Bảng phải: Sự cố & Bảo trì đang chờ xử lý -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" Margin="8,0,0,0"
                        BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="🛠️ Sự cố &amp; Bảo trì đang chờ xử lý" FontSize="15" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Border Background="#FEE2E2" CornerRadius="12" Padding="10,3" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SoSuCoChoXuLy, StringFormat='{}{0} sự cố'}" FontSize="12" FontWeight="Bold" Foreground="#B91C1C"/>
                            </Border>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding DanhSachSuCoChoXuLy}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Phòng" Binding="{Binding MaPhong}" Width="Auto" MinWidth="60" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Nội dung sự cố" Binding="{Binding TieuDe}" Width="*" MinWidth="130"/>
                                <DataGridTextColumn Header="Chi phí" Binding="{Binding ChiPhiText}" Width="Auto" MinWidth="85"/>
                                <DataGridTemplateColumn Header="Trạng thái" Width="Auto" MinWidth="122">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding MauNenBadge}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding TrangThaiText}" Foreground="{Binding MauChuBadge}" FontSize="11.5" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="✅ Tất cả phòng đang hoạt động ổn định, không có sự cố tồn đọng."
                                   Visibility="{Binding HienThiTrongSuCo}"
                                   Foreground="#10B981" FontSize="12.5" FontStyle="Italic" Margin="4,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>