<UserControl x:Class="DoAn.Views.DienNuocView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <UserControl.Resources>
        <DropShadowEffect x:Key="SoftCardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.05"/>

        <Style x:Key="RoundedBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6.6*"/>
            <ColumnDefinition Width="3.4*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= CỘT TRÁI: BẢNG NHẬP CHỈ SỐ ĐIỆN NƯỚC ================= -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,16,0"
                BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
            <DockPanel>
                <!-- Thanh chọn kỳ Tháng/Năm & Tìm kiếm -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📅 Tháng:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding DanhSachThang}" SelectedItem="{Binding ThangChon}"
                                  Width="64" Height="34" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                        <TextBlock Text="Năm:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding DanhSachNam}" SelectedItem="{Binding NamChon}"
                                  Width="78" Height="34" VerticalContentAlignment="Center" Margin="0,0,14,0"/>

                        <TextBlock Text="🔍 Phòng:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
                                 Width="135" Height="34" VerticalContentAlignment="Center" Padding="10,0"
                                 ToolTip="Lọc nhanh theo mã phòng hoặc tên phòng"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right" Content="💾 LƯU CHỈ SỐ" Command="{Binding LuuChiSoDienNuocCommand}"
                            Style="{StaticResource RoundedBtnStyle}" Background="#2563EB" Height="36"/>
                </DockPanel>

                <!-- Dải huy hiệu thống kê nhanh & hướng dẫn -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding TongPhongText}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        </Border>
                        <Border Background="#EFF6FF" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding TongDienText}" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8"/>
                        </Border>
                        <Border Background="#ECFDF5" CornerRadius="10" Padding="10,4">
                            <TextBlock Text="{Binding TongNuocText}" FontSize="12" FontWeight="Bold" Foreground="#047857"/>
                        </Border>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Right" Text="💡 Nhấp đúp vào ô Điện/Nước mới để nhập số rồi bấm Lưu"
                               Foreground="#64748B" FontSize="11.5" FontStyle="Italic" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Bảng DataGrid chốt số điện nước -->
                <DataGrid ItemsSource="{Binding DanhSachChiSo}" AutoGenerateColumns="False" CanUserAddRows="False"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="#F1F5F9" VerticalGridLinesBrush="#F1F5F9">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Phòng" Binding="{Binding MaPhong}" Width="Auto" MinWidth="68" IsReadOnly="True" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Điện cũ" Binding="{Binding ChiSoDienCu, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="78"/>
                        <DataGridTextColumn Header="✏️ Điện mới" Binding="{Binding ChiSoDienMoi, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="92" FontWeight="Bold"/>

                        <!-- Badge tiêu thụ điện (tự báo đỏ nếu Mới < Cũ) -->
                        <DataGridTemplateColumn Header="Tiêu thụ điện" Width="Auto" MinWidth="105" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding MauNenDien}" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding DienTieuThuText}" Foreground="{Binding MauChuDien}" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Nước cũ" Binding="{Binding ChiSoNuocCu, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="78"/>
                        <DataGridTextColumn Header="✏️ Nước mới" Binding="{Binding ChiSoNuocMoi, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="96" FontWeight="Bold"/>

                        <!-- Badge tiêu thụ nước (tự báo đỏ nếu Mới < Cũ) -->
                        <DataGridTemplateColumn Header="Tiêu thụ nước" Width="*" MinWidth="105" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding MauNenNuoc}" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding NuocTieuThuText}" Foreground="{Binding MauChuNuoc}" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ================= CỘT PHẢI: CẤU HÌNH ĐƠN GIÁ ĐIỆN NƯỚC & DỊCH VỤ PHỤ ================= -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"
                BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="⚙️ Đơn giá Điện, Nước &amp; Dịch vụ" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Áp dụng tự động khi lập hóa đơn hàng tháng" FontSize="12" Foreground="#64748B" Margin="0,3,0,12"/>
                    <Separator Background="#E2E8F0" Margin="0,0,0,14"/>

                    <!-- Đơn giá Điện & Nước đặt cạnh nhau gọn gàng -->
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="⚡ Giá Điện (đ / kWh)" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding DonGiaDien, UpdateSourceTrigger=PropertyChanged}" Height="36"
                                     VerticalContentAlignment="Center" Padding="10,0" FontWeight="Bold" Foreground="#1D4ED8"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="💧 Giá Nước (đ / m³)" FontSize="12" FontWeight="SemiBold" Foreground="#047857" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding DonGiaNuoc, UpdateSourceTrigger=PropertyChanged}" Height="36"
                                     VerticalContentAlignment="Center" Padding="10,0" FontWeight="Bold" Foreground="#047857"/>
                        </StackPanel>
                    </UniformGrid>

                    <Separator Background="#E2E8F0" Margin="0,0,0,14"/>

                    <TextBlock Text="📦 Bảng giá Dịch vụ phụ" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,3"/>
                    <TextBlock Text="Nhấp đúp vào cột Đơn giá để thay đổi rồi bấm Cập nhật" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,10"/>

                    <!-- Bảng dịch vụ phụ hiển thị nhãn Cách tính thay vì số 0/1/2 -->
                    <DataGrid ItemsSource="{Binding DanhSachDichVu}" AutoGenerateColumns="False" CanUserAddRows="False"
                              Height="210" Margin="0,0,0,18">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding TenDichVu}" Width="*" MinWidth="105" IsReadOnly="True" FontWeight="Medium"/>
                            <DataGridTextColumn Header="✏️ Đơn giá" Binding="{Binding DonGia, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="84" FontWeight="Bold"/>
                            <DataGridTemplateColumn Header="Cách tính" Width="Auto" MinWidth="92" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TypeBadge" Background="#EFF6FF" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock x:Name="TypeText" Text="Theo phòng" Foreground="#1D4ED8" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding CachTinh}" Value="1">
                                                <Setter TargetName="TypeBadge" Property="Background" Value="#F3E8FF"/>
                                                <Setter TargetName="TypeText" Property="Text" Value="Đầu người"/>
                                                <Setter TargetName="TypeText" Property="Foreground" Value="#7E22CE"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CachTinh}" Value="2">
                                                <Setter TargetName="TypeBadge" Property="Background" Value="#FEF3C7"/>
                                                <Setter TargetName="TypeText" Property="Text" Value="Theo xe"/>
                                                <Setter TargetName="TypeText" Property="Foreground" Value="#B45309"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="✅ CẬP NHẬT BẢNG ĐƠN GIÁ" Command="{Binding LuuDonGiaDichVuCommand}"
                            Style="{StaticResource RoundedBtnStyle}" Background="#10B981" Height="42"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>