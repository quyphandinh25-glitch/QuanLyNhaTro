<UserControl x:Class="DoAn.Views.KhachThueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">

    <UserControl.Resources>
        <DropShadowEffect x:Key="SoftCardShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.05"/>

        <Style x:Key="RoundedBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6.6*"/>
            <ColumnDefinition Width="3.4*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= CỘT TRÁI: DANH SÁCH KHÁCH THUÊ ================= -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18" Margin="0,0,16,0"
                BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
            <DockPanel>
                <!-- Thanh tìm kiếm & lọc trạng thái -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔍 Tìm:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
                                 Width="210" Height="34" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,14,0"
                                 ToolTip="Tìm theo họ tên, CCCD, SĐT, quê quán hoặc mã phòng"/>

                        <TextBlock Text="Tình trạng:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding DanhSachTrangThaiLoc}" SelectedItem="{Binding TrangThaiLocChon}"
                                  Width="155" Height="34" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="12" Padding="12,5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TongHienThiText}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                    </Border>
                </DockPanel>

                <!-- Bảng danh sách khách thuê (tự giãn cột, không che khuất chữ) -->
                <DataGrid ItemsSource="{Binding DanhSachKhachHienThi}" SelectedItem="{Binding KhachHienThiDangChon}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding HoTen}" Width="*" MinWidth="135" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Số CCCD" Binding="{Binding CCCD}" Width="Auto" MinWidth="112"/>
                        <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SoDienThoai}" Width="Auto" MinWidth="102"/>
                        <DataGridTextColumn Header="Quê quán" Binding="{Binding QueQuan}" Width="Auto" MinWidth="95"/>
                        <DataGridTextColumn Header="Nghề nghiệp" Binding="{Binding NgheNghiep}" Width="Auto" MinWidth="95"/>
                        <DataGridTemplateColumn Header="Lưu trú" Width="Auto" MinWidth="118">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding MauNenBadge}" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding MauChamTron}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TrangThaiText}" Foreground="{Binding MauChuBadge}" FontSize="11.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ================= CỘT PHẢI: BIỂU MẪU HỒ SƠ KHÁCH THUÊ ================= -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20"
                BorderBrush="#E2E8F0" BorderThickness="1" Effect="{StaticResource SoftCardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="👥 Hồ sơ Khách thuê" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Chọn khách bên trái để sửa hoặc nhập mới hồ sơ tạm trú" FontSize="12" Foreground="#64748B" Margin="0,3,0,12"/>
                    <Separator Background="#E2E8F0" Margin="0,0,0,14"/>

                    <TextBlock Text="Họ và Tên *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,12"/>

                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Số CCCD / CMND *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CCCD, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" Height="34" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Số điện thoại *" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}" MaxLength="11" Height="34" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Ngày sinh" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding NgaySinh}" Height="34" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Nghề nghiệp" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NgheNghiep, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="10,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Quê quán / Địa chỉ thường trú" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding QueQuan, UpdateSourceTrigger=PropertyChanged}" Height="54" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,6" Margin="0,0,0,18"/>

                    <UniformGrid Columns="2">
                        <Button Content="➕ Thêm khách" Command="{Binding ThemCommand}" Style="{StaticResource RoundedBtnStyle}" Background="#2563EB" Margin="0,0,5,10"/>
                        <Button Content="✏️ Cập nhật" Command="{Binding SuaCommand}" Style="{StaticResource RoundedBtnStyle}" Background="#10B981" Margin="5,0,0,10"/>
                        <Button Content="🗑️ Xóa hồ sơ" Command="{Binding XoaCommand}" Style="{StaticResource RoundedBtnStyle}" Background="#EF4444" Margin="0,0,5,0"/>
                        <Button Content="🔄 Làm mới" Command="{Binding LamMoiCommand}" Style="{StaticResource RoundedBtnStyle}" Background="#64748B" Margin="5,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>