<UserControl x:Class="DoAn.Views.KhachThueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6.5*"/>
            <ColumnDefinition Width="3.5*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: BẢNG KHÁCH THUÊ -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" Margin="0,0,16,0" BorderBrush="#E2E8F0" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="🔍 Tìm kiếm (Tên / CCCD / SĐT):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}" Width="240" Height="32" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding DanhSachKhach}" SelectedItem="{Binding KhachDangChon}"
                          AutoGenerateColumns="False" IsReadOnly="True" RowHeight="36" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderBrush="#CBD5E1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding HoTen}" Width="160" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Số CCCD" Binding="{Binding CCCD}" Width="120"/>
                        <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SoDienThoai}" Width="110"/>
                        <DataGridTextColumn Header="Quê quán" Binding="{Binding QueQuan}" Width="120"/>
                        <DataGridTextColumn Header="Nghề nghiệp" Binding="{Binding NgheNghiep}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- CỘT PHẢI: BIỂU MẪU HỒ SƠ -->
        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="👥 Hồ sơ Khách thuê" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

                <TextBlock Text="Họ và Tên (*)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding HoTen}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                <TextBlock Text="Số CCCD (*)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding CCCD}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                <TextBlock Text="Số điện thoại (*)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SoDienThoai}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                <TextBlock Text="Ngày sinh" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding NgaySinh}" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="Quê quán / Địa chỉ" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding QueQuan}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,10"/>

                <TextBlock Text="Nghề nghiệp" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NgheNghiep}" Height="32" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,18"/>

                <UniformGrid Columns="2">
                    <Button Content="➕ Thêm khách" Command="{Binding ThemCommand}" Background="#2563EB" Foreground="White" FontWeight="Bold" Height="36" Margin="0,0,4,8" BorderThickness="0"/>
                    <Button Content="✏️ Cập nhật" Command="{Binding SuaCommand}" Background="#10B981" Foreground="White" FontWeight="Bold" Height="36" Margin="4,0,0,8" BorderThickness="0"/>
                    <Button Content="🗑️ Xóa hồ sơ" Command="{Binding XoaCommand}" Background="#EF4444" Foreground="White" FontWeight="Bold" Height="36" Margin="0,0,4,0" BorderThickness="0"/>
                    <Button Content="🔄 Làm mới" Command="{Binding LamMoiCommand}" Background="#64748B" Foreground="White" FontWeight="Bold" Height="36" Margin="4,0,0,0" BorderThickness="0"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>