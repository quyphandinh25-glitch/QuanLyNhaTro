<Window x:Class="DoAn.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập hệ thống — Nhà Trọ 8386 Bình Định"
        Height="520" Width="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9">

    <Window.Resources>
        <!-- Style cho khung bọc ô nhập liệu (Tự động sáng viền xanh khi nhấp vào) -->
        <Style x:Key="ModernInputBox" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Height" Value="46"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#3B82F6" BlurRadius="12" ShadowDepth="0" Opacity="0.22"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== CỘT TRÁI: BANNER THƯƠNG HIỆU ==================== -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0.0"/>
                    <GradientStop Color="#1E3A8A" Offset="0.55"/>
                    <GradientStop Color="#2563EB" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid ClipToBounds="True">
                <!-- Vòng tròn trang trí mờ hiện đại -->
                <Ellipse Width="240" Height="240" Fill="White" Opacity="0.05" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-70,-70,0,0"/>
                <Ellipse Width="300" Height="300" Fill="White" Opacity="0.04" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-100,-80"/>

                <StackPanel VerticalAlignment="Center" Margin="36,0">
                    <!-- Icon Tòa nhà -->
                    <Border Width="60" Height="60" CornerRadius="16" Background="#29FFFFFF" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <Path Data="M12,3L2,12H5V20H19V12H22L12,3M12,7.7C14.1,7.7 15.8,9.4 15.8,11.5C15.8,13.6 14.1,15.3 12,15.3C9.9,15.3 8.2,13.6 8.2,11.5C8.2,9.4 9.9,7.7 12,7.7M7,18V16.5C7,15.1 9.2,14 12,14C14.8,14 17,15.1 17,16.5V18H7Z"
                              Fill="White" Stretch="Uniform" Width="30" Height="30"/>
                    </Border>

                    <TextBlock Text="NHÀ TRỌ 8386" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBlock Text="BÌNH ĐỊNH" Foreground="#93C5FD" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>

                    <TextBlock Text="Nền tảng quản trị vận hành và tài chính toàn diện."
                               Foreground="#E2E8F0" FontSize="13.5" TextWrapping="Wrap" LineHeight="21" Opacity="0.92" Margin="0,0,0,22"/>

                    <!-- Đường kẻ phân tách tinh tế -->
                    <Border Height="1" Background="#2EFFFFFF" Margin="0,0,0,22"/>

                    <!-- Danh sách 3 giá trị vận hành cốt lõi -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#2E10B981" Margin="0,0,11,0">
                                <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                      Fill="#34D399" Width="11" Height="11" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Sơ đồ phòng &amp; hợp đồng trực quan" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#2E10B981" Margin="0,0,11,0">
                                <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                      Fill="#34D399" Width="11" Height="11" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Chốt điện nước, lập hóa đơn tự động" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="22" Height="22" CornerRadius="11" Background="#2E10B981" Margin="0,0,11,0">
                                <Path Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"
                                      Fill="#34D399" Width="11" Height="11" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="Kiểm soát công nợ &amp; báo cáo lợi nhuận" Foreground="#F8FAFC" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== CỘT PHẢI: FORM ĐĂNG NHẬP ==================== -->
        <Border Grid.Column="1" Background="White" Padding="52,40">
            <StackPanel VerticalAlignment="Center">

                <!-- Tiêu đề Form -->
                <TextBlock Text="Chào mừng trở lại" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                <TextBlock Text="Vui lòng nhập thông tin tài khoản quản lý để tiếp tục." FontSize="13.5" Foreground="#64748B" Margin="0,0,0,32"/>

                <!-- 1. Ô nhập Tài khoản -->
                <TextBlock Text="TÀI KHOẢN ĐĂNG NHẬP" FontSize="11.5" FontWeight="Bold" Foreground="#475569" Margin="2,0,0,8"/>
                <Border Style="{StaticResource ModernInputBox}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon User -->
                        <Path Grid.Column="0" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                              Fill="#64748B" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>

                        <TextBox x:Name="txtUsername" Grid.Column="1"
                                 Style="{x:Null}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="14" Foreground="#0F172A"
                                 Padding="6,0,0,0"/>
                    </Grid>
                </Border>

                <!-- 2. Ô nhập Mật khẩu -->
                <TextBlock Text="MẬT KHẨU" FontSize="11.5" FontWeight="Bold" Foreground="#475569" Margin="2,0,0,8"/>
                <Border Style="{StaticResource ModernInputBox}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon Khóa -->
                        <Path Grid.Column="0" Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                              Fill="#64748B" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>

                        <PasswordBox x:Name="txtPassword" Grid.Column="1"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     FontSize="14" Foreground="#0F172A"
                                     Padding="6,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Thông báo lỗi (Ẩn mặc định) -->
                <TextBlock x:Name="txtError"
                           Foreground="#DC2626" FontSize="12.5" FontWeight="Medium"
                           TextWrapping="Wrap" Margin="2,0,0,16"
                           Visibility="Collapsed"/>

                <!-- Nút Đăng nhập (Hỗ trợ bấm phím Enter) -->
                <Button Content="ĐĂNG NHẬP HỆ THỐNG"
                        Click="BtnLogin_Click"
                        IsDefault="True"
                        Height="48" Cursor="Hand"
                        Foreground="White" FontSize="14" FontWeight="Bold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#2563EB" Offset="0.0"/>
                                        <GradientStop Color="#1D4ED8" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#2563EB" BlurRadius="14" ShadowDepth="3" Opacity="0.35"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#1D4ED8" Offset="0.0"/>
                                                <GradientStop Color="#1E40AF" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Chân trang nhỏ -->
                <TextBlock Text="© 2026 Nhà Trọ 8386 Bình Định • Phiên bản 1.0"
                           HorizontalAlignment="Center" Foreground="#94A3B8"
                           FontSize="11.5" Margin="0,28,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>