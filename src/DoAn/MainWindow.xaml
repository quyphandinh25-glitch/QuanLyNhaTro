<Window x:Class="DoAn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DoAn.ViewModels"
        Title="Hệ thống Quản lý Nhà Trọ"
        Height="820" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F1F5F9">

    <!-- Gắn MainViewModel làm DataContext cho cửa sổ chính -->
    

    <Window.Resources>
        <!-- Style nút điều hướng Sidebar có vạch Active Indicator -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="MainBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ActiveIndicator" Grid.Column="0" Width="4" Height="22" CornerRadius="2"
                                        Background="#38BDF8" Visibility="Collapsed" HorizontalAlignment="Left" Margin="-8,0,0,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#1E293B"/>
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR BÊN TRÁI ================= -->
        <Border Grid.Column="0" Background="#0F172A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo & Tên nhà trọ động từ AuthService -->
                <Border Grid.Row="0" Padding="20,24,20,20" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#2563EB" Margin="0,0,12,0">
                            <TextBlock Text="🏢" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="QUẢN LÝ NHÀ TRỌ" Foreground="White" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="{Binding TenNhaTro}" Foreground="#38BDF8" FontSize="12.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Danh sách Menu dùng ChuyenManHinhCommand + CommandParameter -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="DANH MỤC QUẢN LÝ" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="24,0,0,8"/>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}" IsChecked="True"
                                 Command="{Binding ChuyenManHinhCommand}" CommandParameter="Dashboard"
                                 Content="📊   Tổng quan (Dashboard)"/>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 Command="{Binding ChuyenManHinhCommand}" CommandParameter="SoDoPhong"
                                 Content="🗺️   Sơ đồ phòng"/>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 Command="{Binding ChuyenManHinhCommand}" CommandParameter="Phong"
                                 Content="🚪   Quản lý Phòng"/>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 Command="{Binding ChuyenManHinhCommand}" CommandParameter="KhachThue"
                                 Content="👥   Khách thuê"/>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 Command="{Binding ChuyenManHinhCommand}" CommandParameter="HopDong"
                                 Content="📄   Hợp đồng thuê"/>

                    <TextBlock Text="TÀI CHÍNH &amp; VẬN HÀNH" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="24,18,0,8"/>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 Command="{Binding ChuyenManHinhCommand}" CommandParameter="DienNuoc"
                                 Content="⚡   Chốt Điện &amp; Nước"/>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 Command="{Binding ChuyenManHinhCommand}" CommandParameter="HoaDon"
                                 Content="🧾   Hóa đơn &amp; Thu tiền"/>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 Command="{Binding ChuyenManHinhCommand}" CommandParameter="SuCo"
                                 Content="🛠️   Sự cố &amp; Bảo trì"/>
                </StackPanel>

                <!-- Nút Đăng xuất -->
                <Border Grid.Row="2" Padding="16" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                    <Button Command="{Binding DangXuatCommand}" Cursor="Hand" Height="40" Background="#1E293B" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="LogoutBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🚪" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Đăng xuất" Foreground="#F87171" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LogoutBorder" Property="Background" Value="#331E29"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- ================= VÙNG NỘI DUNG BÊN PHẢI ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TieuDeManHinh}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="{Binding MoTaManHinh}" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,14,0">
                            <TextBlock Text="{Binding NgayHienTai}" Foreground="#475569" FontSize="12.5" FontWeight="Medium"/>
                        </Border>

                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="20" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤 " FontSize="12.5"/>
                                <TextBlock Text="{Binding TenNguoiDung}" Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="12.5"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Khung chứa các View con -->
            <Border Grid.Row="1" Padding="20">
                <ContentControl Content="{Binding CurrentView}"/>
            </Border>
        </Grid>
    </Grid>
</Window>